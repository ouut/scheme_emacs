;;; test_config.el --- Comprehensive Test Suite for Steel Scheme Emacs Setup -*- lexical-binding: t; -*-

(require 'ert)
(load (expand-file-name "init.el" (file-name-directory (or load-file-name buffer-file-name default-directory))))

;;; 1. Test Keybindings in Scheme Mode
(ert-deftest test-keybindings-in-scheme-mode ()
  (with-temp-buffer
    (scheme-mode)
    (should (eq (key-binding (kbd "M-h")) 'paredit-wrap-round))
    (should (eq (key-binding (kbd "M-H")) 'paredit-wrap-square))
    (should (eq (key-binding (kbd "M-S-h")) 'paredit-wrap-square))
    (should (eq (key-binding (kbd "M-l")) 'paredit-forward-slurp-sexp))
    (should (eq (key-binding (kbd "M-L")) 'strict-paredit-transpose-dwim))
    (should (eq (key-binding (kbd "M-S-l")) 'strict-paredit-transpose-dwim))
    (should (eq (key-binding (kbd "M-j")) 'paredit-forward-barf-sexp))
    (should (eq (key-binding (kbd "M-J")) 'paredit-split-sexp))
    (should (eq (key-binding (kbd "M-S-j")) 'paredit-split-sexp))
    (should (eq (key-binding (kbd "M-k")) 'er/expand-region))
    (should (eq (key-binding (kbd "M-K")) 'er/contract-region))
    (should (eq (key-binding (kbd "M-S-k")) 'er/contract-region))
    (should (eq (key-binding (kbd "M-o")) 'strict-paredit-splice-dwim))
    (should (eq (key-binding (kbd "M-w")) 'strict-paredit-step-into))
    (should (eq (key-binding (kbd "M-s")) 'strict-paredit-step-out))
    (should (eq (key-binding (kbd "M-1")) 'paredit-backward))
    (should (eq (key-binding (kbd "M-2")) 'paredit-forward))
    (should (eq (key-binding (kbd "M-3")) 'mark-defun))
    (should (eq (key-binding (kbd "M-\\")) 'strict-paredit-indent-dwim))
    (should (eq (key-binding (kbd "M-RET")) 'steel-eval-dwim))
    (should (eq (key-binding (kbd "<M-return>")) 'steel-eval-dwim))
    (should (eq (key-binding (kbd "C-RET")) 'steel-eval-dwim))
    (should (eq (key-binding (kbd "<C-return>")) 'steel-eval-dwim))
    (should (eq (key-binding (kbd "<s-return>")) 'steel-eval-dwim))
    (should (eq (key-binding (kbd "s-h")) 'paredit-wrap-round))
    (should (eq (key-binding (kbd "s-k")) 'er/expand-region))
    (should (eq (key-binding (kbd "s-l")) 'paredit-forward-slurp-sexp))
    (should (eq (key-binding (kbd "C-c C-c")) 'steel-send-definition))
    (should (eq (key-binding (kbd "C-c C-b")) 'steel-send-buffer))
    (should (memq (key-binding (kbd "C-c C-z")) '(steel-toggle-repl steel-switch-to-repl)))
    (should (eq (key-binding (kbd "C-c C-q")) 'steel-hide-repl))
    (should (eq (key-binding (kbd "C-c C-d")) 'steel-kill-repl))))

;;; 2. Test Wrap: Alt + H and Alt + Shift + H
(ert-deftest test-structural-wrap ()
  (with-temp-buffer
    (scheme-mode)
    (insert "cards")
    (goto-char (point-min))
    (paredit-wrap-round)
    (should (string= (buffer-string) "(cards)"))
    (goto-char 2) ; inside (cards)
    (strict-paredit-splice-dwim)
    (should (string= (buffer-string) "cards"))
    (goto-char (point-min))
    (paredit-wrap-square)
    (should (string= (buffer-string) "[cards]"))))

;;; 3. Test Slurp (Alt + L) and Barf (Alt + J)
(ert-deftest test-slurp-and-barf ()
  (with-temp-buffer
    (scheme-mode)
    (insert "(a b) c")
    (search-backward "b")
    ;; Slurp: (a b) c -> (a b c)
    (paredit-forward-slurp-sexp)
    (should (string-match-p "(a b c)" (buffer-string)))
    ;; Barf: (a b c) -> (a b) c
    (paredit-forward-barf-sexp)
    (should (string-match-p "(a b) *c" (buffer-string)))))

;;; 4. Test Split (Alt + Shift + J) and Transpose (Alt + Shift + L)
(ert-deftest test-split-and-transpose ()
  (with-temp-buffer
    (scheme-mode)
    (insert "(a b  c d)")
    (goto-char 6)
    (paredit-split-sexp)
    (should (string-match-p "(a b) *(c d)" (buffer-string))))
  (with-temp-buffer
    (scheme-mode)
    (insert "(equal? alpha beta)")
    (search-backward "alpha")
    (strict-paredit-transpose-dwim)
    (should (string= (buffer-string) "(equal? beta alpha)"))))

;;; 5. Test Step Into (Alt + W) and Step Out (Alt + S)
(ert-deftest test-step-into-and-out ()
  (with-temp-buffer
    (scheme-mode)
    (insert "(define (foo x) (+ x 1))")
    (goto-char (point-min))
    (strict-paredit-step-into)
    (should (eq (char-after) ?d))
    (search-forward "+")
    (strict-paredit-step-out)
    (should (eq (char-after) 40))
    (strict-paredit-step-out)
    (should (eq (char-after) 40))))

;;; 6. Test Vertical Breathing Expand/Contract (Alt + K / Alt + Shift + K)
(ert-deftest test-expand-and-contract-region ()
  (with-temp-buffer
    (scheme-mode)
    (insert "(define (fib n) (+ n 1))")
    (search-backward "n")
    (er/expand-region 1)
    (should (string= (buffer-substring (region-beginning) (region-end)) "n"))
    (er/expand-region 1)
    (should (string= (buffer-substring (region-beginning) (region-end)) "+ n 1"))
    (er/contract-region 1)
    (should (string= (buffer-substring (region-beginning) (region-end)) "n"))))

;;; 7. Test Steel REPL Execution
(ert-deftest test-steel-repl-evaluation ()
  (let ((proc (run-steel nil)))
    (should (processp proc))
    (should (process-live-p proc))
    (sit-for 0.5)
    (with-temp-buffer
      (scheme-mode)
      (insert "(define (fact n) (if (<= n 1) 1 (* n (fact (- n 1)))))\n")
      (steel-send-buffer)
      (sit-for 0.5)
      (insert "(fact 5)\n")
      (search-backward ")")
      (forward-char 1)
      (steel-eval-dwim)
      (sit-for 0.5))
    (let ((repl-text (with-current-buffer steel-repl-buffer-name (buffer-string))))
      (should (string-match-p "=> 120" repl-text)))
    (delete-process proc)
    (kill-buffer steel-repl-buffer-name)))

;;; 8. Test Global Fallback Keybindings (Active Across Non-Scheme Buffers)
(ert-deftest test-global-eval-fallback ()
  (with-temp-buffer
    (fundamental-mode)
    (should (eq (key-binding (kbd "M-RET")) 'steel-eval-dwim))
    (should (eq (key-binding (kbd "<M-return>")) 'steel-eval-dwim))
    (should (eq (key-binding (kbd "C-RET")) 'steel-eval-dwim))
    (should (eq (key-binding (kbd "<C-return>")) 'steel-eval-dwim))
    (should (eq (key-binding (kbd "<s-return>")) 'steel-eval-dwim))
    (should (eq (key-binding (kbd "C-c C-z")) 'steel-toggle-repl))))

;;; 9. Test Scratch Buffer Configuration
(ert-deftest test-scratch-buffer-initialization ()
  (let ((buf (get-buffer "*scratch*")))
    (when buf
      (with-current-buffer buf
        (should (eq major-mode 'scheme-mode))
        (should (eq (key-binding (kbd "M-RET")) 'steel-eval-dwim))
        (should (eq (key-binding (kbd "M-h")) 'paredit-wrap-round))
        (should (eq (key-binding (kbd "M-k")) 'er/expand-region))))))
